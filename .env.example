# ========================================================
# THE 99 ORNAMENTS STORE - FIREBASE FIRESTORE CLOUD CONFIG
# ========================================================
# 1. Create a free project at https://console.firebase.google.com/
# 2. Add a Web App and enable Cloud Firestore database in Test mode or Production mode.
# 3. Copy the Firebase Web SDK credentials below.
# 4. In Vercel, paste these in: Project Settings -> Environment Variables.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKeyForYourFirebaseProject
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef99store

